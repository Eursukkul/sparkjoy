# Copy to .env before running docker compose (compose reads .env automatically).
# All values below are safe development defaults — no real secrets.

POSTGRES_USER=sparkjoy
POSTGRES_PASSWORD=sparkjoy
POSTGRES_DB=sparkjoy

# Sign/verify JWTs — use a long random string in any real deployment
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Test account created by the seed (login credentials)
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=Password123!

# Set to true when serving over HTTPS so the auth cookie is Secure
# COOKIE_SECURE=true
